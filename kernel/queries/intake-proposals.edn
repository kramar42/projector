;; The intents projector's intake proposed that the owner has not answered yet: still proposed, and
;; proposed by system:projector (the intent/proposed event that is its origin comes from it) without
;; owning a spec, which tells an inbox card's intent from the standing intents the registration
;; proposes for projector's scheduled specs. When it was proposed, and each entity it is about by
;; alias, or "" when it names none; one row per intent and alias.
[:find ?intent ?statement ?at ?about
 :where
 (proposed-intent ?intent)
 [?intent :intent/origin ?o]
 [?o :event/kind :intent/proposed]
 [?o :event/source ?s]
 (alias ?s "system:projector")
 (not [?intent :intent/specs _])
 [?intent :intent/statement ?statement]
 [?o :event/at ?at]
 (or-join [?intent ?about]
   (and [?intent :intent/about ?e]
        [?e :entity/aliases ?about])
   (and (not [?intent :intent/about _])
        [(ground "") ?about]))]
