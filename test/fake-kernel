#!/bin/sh
# A stand-in for the owner's kernel CLI, for test/intents.test.ts, test/import.test.ts
# and test/kernel.test.ts.
#
# `query --saved projector/<name> [--in k=v ...] [--limit n] --json` prints the
# answer in test/kernel-queries/<name>.json, or in $FAKE_KERNEL_QUERIES/<name>.json
# when that directory has one — a test writes what the kernel holds there. Inputs
# are not read: a fixture is the answer to the inputs the test gives. A query
# with no fixture, or the one FAKE_KERNEL_QUERY_FAIL names, is refused the way a
# kernel that never registered it refuses it. Every call is appended to
# FAKE_KERNEL_LOG as `KERNEL_DB|arg arg …`, so a test can read back exactly what
# projector asked and wrote. `judge` and `capture` print the line the real CLI prints.
# `ingest` appends the batch it was given on stdin, one line per batch, to
# FAKE_KERNEL_BATCHES and answers with a JSON object as the real one does;
# `register` says what it registered; `attempt start <spec> … --json` answers a
# running attempt with a fixed id (FAKE_KERNEL_ATTEMPT_FAIL makes it refuse, as a
# kernel without the spec does) and `attempt end <id> <status>` echoes the two
# back. FAKE_KERNEL_FAIL makes every call refuse, the way a locked store does.
[ -n "$FAKE_KERNEL_LOG" ] && printf '%s|%s\n' "$KERNEL_DB" "$*" >> "$FAKE_KERNEL_LOG"
if [ -n "$FAKE_KERNEL_FAIL" ]; then
  echo "error: store is locked {}" >&2
  exit 2
fi
case "$1" in
  query)
    if [ "$2" != "--saved" ]; then echo "error: the fake kernel answers saved queries only {}" >&2; exit 1; fi
    ref="$3"
    name="${ref#projector/}"
    fixture="$(dirname "$0")/kernel-queries/$name.json"
    [ -n "$FAKE_KERNEL_QUERIES" ] && [ -f "$FAKE_KERNEL_QUERIES/$name.json" ] && fixture="$FAKE_KERNEL_QUERIES/$name.json"
    if [ "$name" = "$ref" ] || [ "$FAKE_KERNEL_QUERY_FAIL" = "$name" ] || [ ! -f "$fixture" ]; then
      echo "error: no saved query $ref: orient lists them under schema.queries as <system>/<name> {}" >&2
      exit 1
    fi
    if [ "$name" = "intake-newest" ] && [ -n "$FAKE_KERNEL_BATCHES" ] && [ ! -f "$FAKE_KERNEL_QUERIES/intake-newest.json" ]; then
      # A batch is one JSON line, and an event's key, kind and at come in that
      # order: the newest at of each intake/ kind, as the kernel's (max ?at).
      rows=""
      if [ -f "$FAKE_KERNEL_BATCHES" ]; then
        rows=$(grep -o '"kind":"intake/[a-z]*","at":"[^"]*"' "$FAKE_KERNEL_BATCHES" |
          sed 's/"kind":"\(intake\/[a-z]*\)","at":"\([^"]*\)"/\1 \2/' |
          sort -k1,1 -k2,2r |
          awk '!seen[$1]++ { printf "%s[\":%s\", \"%s\"]", (n++ ? ", " : ""), $1, $2 }')
      fi
      echo "{\"columns\": [\"kind\", \"(max ?at)\"], \"rows\": [$rows], \"query\": \"$ref\"}"
      exit 0
    fi
    cat "$fixture"
    ;;
  judge)
    echo "judgment 12345678 intent $(printf '%s' "$2" | cut -c1-8) -> $3"
    ;;
  capture)
    echo "intent  c0ffee00  event  0e0e0e0e  $2"
    ;;
  ingest)
    batch=$(cat)
    [ -n "$FAKE_KERNEL_BATCHES" ] && printf '%s\n' "$batch" >> "$FAKE_KERNEL_BATCHES"
    echo "{\"source\": \"$3\", \"entities-new\": 0, \"events-new\": 0, \"proposals-new\": 0}"
    ;;
  register)
    echo "registered system:projector from $2"
    ;;
  attempt)
    case "$2" in
      start)
        if [ -n "$FAKE_KERNEL_ATTEMPT_FAIL" ]; then echo "error: no spec named $3 {}" >&2; exit 1; fi
        echo "{\"id\": \"a77e3f00-0000-4000-8000-000000000001\", \"spec\": \"$3\", \"status\": \"running\", \"executor\": \"projector-intake\"}"
        ;;
      end)
        echo "{\"id\": \"$3\", \"status\": \"$4\"}"
        ;;
      *)
        echo "attempt start|end" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    echo "unknown command $1"
    exit 1
    ;;
esac
