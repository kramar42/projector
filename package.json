{
  "name": "projector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "pj": "./src/cli/pj.ts"
  },
  "scripts": {
    "pj": "node src/cli/pj.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch src/server/serve.ts",
    "dev:web": "vite",
    "build": "vite build",
    "serve": "node src/server/serve.ts",
    "states": "node scripts/states.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.1.0",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@dagrejs/dagre": "^3.1.1",
    "@hono/node-server": "^1.13.0",
    "@xyflow/react": "^12.11.3",
    "chokidar": "^5.0.0",
    "hono": "^4.13.3",
    "marked": "^18.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "wouter": "^3.10.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
